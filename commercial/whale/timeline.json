{
 "lines": [
  {
   "id": "l_intro",
   "who": "lawyer",
   "t": 3.7,
   "end": 8.891,
   "text": "We're here for the reading of the will. Mister Whale insisted on being present."
  },
  {
   "id": "w_cons",
   "who": "whale",
   "t": 9.3,
   "end": 11.714,
   "text": "I'm not dying. I'm... consolidating."
  },
  {
   "id": "wi_weeks",
   "who": "wife",
   "t": 12.1,
   "end": 14.578,
   "text": "Baby, the doctor gave you two weeks."
  },
  {
   "id": "w_bear",
   "who": "whale",
   "t": 14.9,
   "end": 16.181,
   "text": "The doctor's bearish."
  },
  {
   "id": "l_wife",
   "who": "lawyer",
   "t": 16.7,
   "end": 19.91,
   "text": "To my loving wife, I leave... my bags."
  },
  {
   "id": "wi_bags",
   "who": "wife",
   "t": 20.1,
   "end": 21.028000000000002,
   "text": "Your bags?"
  },
  {
   "id": "w_down",
   "who": "whale",
   "t": 21.3,
   "end": 23.727,
   "text": "Down ninety-eight percent. You'll love them."
  },
  {
   "id": "s_house",
   "who": "son",
   "t": 24.1,
   "end": 25.727,
   "text": "Dad, did you leave me the house?"
  },
  {
   "id": "w_lev",
   "who": "whale",
   "t": 26.0,
   "end": 28.717,
   "text": "I leveraged the house, son. A hundred x."
  },
  {
   "id": "p_conf",
   "who": "priest",
   "t": 31.0,
   "end": 33.252,
   "text": "Would you like to confess your sins?"
  },
  {
   "id": "w_orph",
   "who": "whale",
   "t": 33.6,
   "end": 34.962,
   "text": "I rugged an orphanage."
  },
  {
   "id": "w_twice",
   "who": "whale",
   "t": 35.6,
   "end": 37.053000000000004,
   "text": "Twice. They bought the dip."
  },
  {
   "id": "w_hold",
   "who": "whale",
   "t": 37.7,
   "end": 39.410000000000004,
   "text": "Hold on... someone's selling."
  },
  {
   "id": "wi_dump",
   "who": "wife",
   "t": 44.3,
   "end": 45.501999999999995,
   "text": "He dumped on us."
  },
  {
   "id": "s_grave",
   "who": "son",
   "t": 45.75,
   "end": 47.109,
   "text": "From beyond the grave."
  },
  {
   "id": "l_exit",
   "who": "lawyer",
   "t": 47.45,
   "end": 52.222,
   "text": "And to everyone in this room... thank you for being my exit liquidity."
  },
  {
   "id": "w_dip",
   "who": "whale",
   "t": 56.35,
   "end": 57.304,
   "text": "...buy the dip."
  }
