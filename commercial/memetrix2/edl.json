"f": 29.139,
"dur": 1.377,
"who": "anon",
"sub": "...Where is the exit, Slerf?"
},
{
"id": "s11",
"f": 30.866,
"dur": 3.208,
"who": "slerf",
"sub": "Nobody-knows-the-only-one-who-knows-is-the-Keyholder-and-the-Keyholder-is-at-the-caf\u00e9!"
},
{
"id": "mo10",
"f": 34.674,
"dur": 2.53,
"who": "mom",
"sub": "Honey, are you going out? It's very red outside!"
},
{
