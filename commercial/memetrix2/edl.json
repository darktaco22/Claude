"f": 10.3,
"dur": 4.788,
"who": "mensa",
"sub": "It's not a dip. It's a rug. Somebody's pulling the floor out from under the whole Memetrix."
},
{
"id": "m10",
"f": 15.438,
"dur": 0.815,
"who": "michi",
"sub": "Jeanphil?"
},
{
"id": "n11",
"f": 16.503,
"dur": 5.639,
"who": "mensa",
"sub": "Jeanphil. He's not chasing us anymore. He's copying himself. Every wallet he touches becomes him."
},
{
"id": "a10",
"f": 22.492,
"dur": 1.418,
"who": "anon",
"sub": "Then we find who's paying him."
},
{
"id": "s10",
"f": 24.26,
"dur": 3.979,
"who": "slerf",
"sub": "The Whale... has... the exit."
},
{
