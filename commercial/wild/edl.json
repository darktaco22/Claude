"subs": {
"n1a": "The arena, at dawn.",
"n1b": "For millions of years, nothing here has had any utility.",
"n2a": "The Pepe. Patient. Dignified.",
"n2b": "Down ninety-four percent, and telling no one.",
"n3a": "Nearby, the paper-handed herd grazes in peace.",
"n3b": "A dip of two percent.",
"n3c": "They will return at the top.",
"n4a": "Two males compete for dominance.",
"n4b": "Neither has read the whitepaper. There is no whitepaper.",
"n5a": "And then, the rarest sight in nature.",
"n5b": "A god candle.",
"n5c": "The whole valley rejoices. Nobody sells.",
"n6a": "Ah. The rug pull.",
"n6b": "I should mention that I am also in this one.",
"n6c": "Excuse me.",
"n7a": "The Pepe. Now down ninety-nine.",
"n7b": "Still telling no one.",
"n8": "Free to play. Mercifully."
}
